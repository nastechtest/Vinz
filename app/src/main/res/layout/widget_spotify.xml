<?xml version="1.0" encoding="utf-8"?>
<!-- Spotify's look: a near-black bar, a small square cover, white and grey text, a green play button. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel"
    android:backgroundTint="#FF181818"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:id="@+id/widget_open"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_art"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/widget_art_frame_small"
                    android:contentDescription="@string/widget_open"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/widget_nothing"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#FFB3B3B3"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_like"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/widget_like"
                android:padding="8dp"
                android:src="@drawable/ic_w_heart_outline" />

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/widget_previous"
                android:padding="6dp"
                android:src="@drawable/ic_w_prev" />

            <ImageView
                android:id="@+id/widget_play"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_circle"
                android:backgroundTint="#FF1ED760"
                android:contentDescription="@string/widget_play"
                android:padding="9dp"
                android:src="@drawable/ic_w_play"
                android:tint="#FF000000" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/widget_next"
                android:padding="6dp"
                android:src="@drawable/ic_w_next" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="6dp"
            android:max="1000"
            android:progressDrawable="@drawable/widget_progress_green" />
    </LinearLayout>
</FrameLayout>
