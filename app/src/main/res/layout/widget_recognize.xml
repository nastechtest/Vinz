<?xml version="1.0" encoding="utf-8"?>
<!-- Recognize (4×2): the last song recognized, with Play, beside the round Recognize button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel"
    android:backgroundTint="#FF1B1B22"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/rw_open"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/rw_art"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/widget_art_frame"
                android:contentDescription="@string/widget_recognize_open"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_tile_recognize" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/rw_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/widget_recognize_label"
                    android:textColor="#FFB9A8FF"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/rw_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_recognize_empty"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/rw_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/widget_recognize_empty_hint"
                    android:textColor="#BFFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/rw_play"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/widget_panel"
            android:backgroundTint="#33FFFFFF"
            android:contentDescription="@string/widget_recognize_play"
            android:drawableStart="@drawable/ic_w_play"
            android:drawablePadding="6dp"
            android:drawableTint="#FFFFFFFF"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:text="@string/widget_play"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <ImageView
        android:id="@+id/rw_listen"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/widget_play_ring"
        android:tint="#FF121212"
        android:contentDescription="@string/widget_recognize_listen"
        android:padding="17dp"
        android:src="@drawable/ic_tile_recognize" />
</LinearLayout>
