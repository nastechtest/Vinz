<?xml version="1.0" encoding="utf-8"?>
<!-- Recognize (3×1 / 4×1): one row: the last song recognized, Play, and the round Recognize button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel"
    android:backgroundTint="#FF1B1B22"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:id="@+id/rw_open"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/rw_art"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_art_frame"
            android:contentDescription="@string/widget_recognize_open"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_tile_recognize" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rw_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_recognize_empty"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rw_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_recognize_empty_hint"
                android:textColor="#BFFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/rw_play"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_circle"
        android:backgroundTint="#33FFFFFF"
        android:contentDescription="@string/widget_recognize_play"
        android:padding="10dp"
        android:src="@drawable/ic_w_play"
        android:tint="#FFFFFFFF" />

    <ImageView
        android:id="@+id/rw_listen"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_circle"
        android:backgroundTint="#FF7C5CFF"
        android:contentDescription="@string/widget_recognize_listen"
        android:padding="13dp"
        android:src="@drawable/ic_tile_recognize" />
</LinearLayout>
