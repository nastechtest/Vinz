<?xml version="1.0" encoding="utf-8"?>
<!-- Vinz TV's music video (TvVideoSurface): a SurfaceView, so the picture goes to the display's own video layer and the
     window over it (lyrics, scrim, controls) is drawn again only when they change. The phone keeps texture_player. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="surface_view"
    app:use_controller="false"
    app:shutter_background_color="@android:color/transparent" />
