<?xml version="1.0" encoding="utf-8"?>
<!-- Strip (4×1): a slim bar in the cover's color, the cover, the title, and previous / play / next. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel"
    android:backgroundTint="#FF2A2A30"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_panel" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_sheen" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="6dp">

        <LinearLayout
            android:id="@+id/widget_open"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_art"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/widget_open"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_nothing"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/widget_previous"
            android:padding="9dp"
            android:src="@drawable/ic_w_prev" />

        <ImageView
            android:id="@+id/widget_play"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_play_ring"
            android:contentDescription="@string/widget_play"
            android:padding="10dp"
            android:src="@drawable/ic_w_play"
            android:tint="#FF121212" />

        <ImageView
            android:id="@+id/widget_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/widget_next"
            android:padding="9dp"
            android:src="@drawable/ic_w_next" />
    </LinearLayout>

    <ImageView android:id="@+id/widget_like" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <ProgressBar android:id="@+id/widget_progress" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
</FrameLayout>
