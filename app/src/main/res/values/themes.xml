<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Vinz" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- Pure black (1.8): the window the system shows before the first frame is now the same black the splash is drawn
         on, so the launcher's icon fades into the starfield instead of through a lighter panel. -->
    <color name="splash_bg">#000000</color>
    <color name="ic_launcher_background">#0B0A12</color>
</resources>
