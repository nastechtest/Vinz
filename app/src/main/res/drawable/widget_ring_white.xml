<?xml version="1.0" encoding="utf-8"?>
<!-- The disc widget's progress in White light: a faint ring, and the part played in white from the top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="ring" android:innerRadiusRatio="2.22" android:thickness="3dp" android:useLevel="false">
            <solid android:color="#40FFFFFF" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate android:fromDegrees="270" android:toDegrees="270" android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="ring" android:innerRadiusRatio="2.22" android:thickness="3dp" android:useLevel="true">
                <solid android:color="#FFFFFFFF" />
            </shape>
        </rotate>
    </item>
</layer-list>