<?xml version="1.0" encoding="utf-8"?>
<!-- Prism's widgets: a faint track and the part played in split light. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><corners android:radius="2dp" /><solid android:color="#33FFFFFF" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:clipOrientation="horizontal" android:gravity="start" android:drawable="@drawable/widget_spectrum_bar" />
    </item>
</layer-list>
