<?xml version="1.0" encoding="utf-8"?>
<!-- The disc widget's progress: a faint ring all the way round, and the part played in split light from the top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="ring" android:innerRadiusRatio="2.22" android:thickness="3dp" android:useLevel="false">
            <solid android:color="#40FFFFFF" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate android:fromDegrees="270" android:toDegrees="270" android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="ring" android:innerRadiusRatio="2.22" android:thickness="3dp" android:useLevel="true">
                <gradient android:type="sweep" android:startColor="#FFFF4D5E" android:centerColor="#FF3DDC97" android:endColor="#FF7C5CFF" android:useLevel="false" />
            </shape>
        </rotate>
    </item>
</layer-list>
