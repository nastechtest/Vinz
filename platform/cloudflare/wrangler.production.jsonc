{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vinz",
  "main": "vinz-api.js",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SUPABASE_URL": "https://iszghebmetrbkfhnnoqq.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_9UXwKG0oVl1J9zIkJ-bZKg_W-fkotZe",
    "POSTHOG_HOST": "https://us.i.posthog.com",
    "ALLOWED_ORIGINS": "https://home.vinzmusic.workers.dev"
  },
  "r2_buckets": [
    { "binding": "BACKUPS_BUCKET", "bucket_name": "vinz-backups" }
  ],
  "kv_namespaces": [
    { "binding": "CATALOG_CACHE", "id": "dc7be60ce85f490bb473ef321dec9e5d" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "persist": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1, "persist": true }
  }
}
