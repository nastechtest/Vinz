{
  "name": "vinz-api-staging",
  "main": "vinz-api.js",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "USERNAME_CHECK_LIMITER",
      "namespace_id": "6201109",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://iszghebmetrbkfhnnoqq.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_9UXwKG0oVl1J9zIkJ-bZKg_W-fkotZe",
    "POSTHOG_HOST": "https://us.i.posthog.com"
  },
  "r2_buckets": [
    {
      "binding": "BACKUPS_BUCKET",
      "bucket_name": "vinz-backups"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CATALOG_CACHE",
      "id": "3e172dca32ca48e9be8d09b30f6a2a96"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    }
  }
}
